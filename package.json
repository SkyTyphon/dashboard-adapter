{
  "name": "dashboard-adapter",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "test:browser": "npm run build:demo && node scripts/browser-smoke.mjs",
    "test:bilingual": "npm run build:demo && node scripts/bilingual-smoke.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.0"
  }
}
